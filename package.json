{
  "name": "scamwatch-chat-pcf",
  "version": "1.0.0",
  "description": "Power Apps code component (PCF) chat UI for the Scamwatch Text-to-SQL assistant",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pcf-scripts build",
    "build:prod": "pcf-scripts build --buildMode production",
    "clean": "pcf-scripts clean",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "lint": "eslint ScamwatchChat dev scripts",
    "lint:fix": "eslint ScamwatchChat dev scripts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "preview": "vite --config dev/vite.config.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "solution": "bash scripts/build-solution.sh",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.0.0",
    "@fluentui/react-components": "9.46.2",
    "markdown-to-jsx": "^7.7.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "react-window": "^1.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fluentui/react-icons": "^2.0.343",
    "@microsoft/eslint-plugin-power-apps": "^0.5.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/powerapps-component-framework": "^1.3.18",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pcf-scripts": "^1.51.1",
    "pcf-start": "^1.51.1",
    "playwright": "^1.63.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.6",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21"
  }
}
